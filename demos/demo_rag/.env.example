# Copy or source the real .env used by the demo:
# source demos/demo_rag/.env

DEMO_RAG_PDF_DIR=pdf

DEMO_RAG_ORACLE_DSN=
DEMO_RAG_ORACLE_USER=admin
DEMO_RAG_ORACLE_PASSWORD=
DEMO_RAG_ORACLE_WALLET_LOCATION=
DEMO_RAG_ORACLE_WALLET_PASSWORD=
DEMO_RAG_ORACLE_TABLE_NAME=locus_demo_rag_vectors
DEMO_RAG_ORACLE_SCHEMA_NAME=
DEMO_RAG_ORACLE_DISTANCE_METRIC=COSINE

DEMO_RAG_OCI_EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
DEMO_RAG_OCI_COMPARTMENT_ID=
DEMO_RAG_OCI_PROFILE_NAME=DEFAULT
DEMO_RAG_OCI_AUTH_TYPE=api_key
DEMO_RAG_OCI_SERVICE_ENDPOINT=
DEMO_RAG_OCI_CONFIG_FILE=~/.oci/config
LOCUS_OCI_REGION=us-chicago-1

DEMO_RAG_AGENT_MODEL=oci:openai.gpt-5.5
DEMO_RAG_AGENT_SERVER_URL=http://127.0.0.1:8000

DEMO_RAG_CHUNK_SIZE=1000
DEMO_RAG_CHUNK_OVERLAP=200
DEMO_RAG_CLEAR_BEFORE_LOAD=false
DEMO_RAG_LOG_LEVEL=INFO
